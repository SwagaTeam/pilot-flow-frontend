{
  "name": "pilot-flow-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "test": "ng test --watch=false",
    "generate:contract": "node scripts/generate-contract.mjs",
    "mock": "node mock-server.mjs",
    "format": "prettier --write src scripts angular.json package.json proxy.conf.json tsconfig*.json README.md",
    "format:check": "prettier --check src scripts angular.json package.json proxy.conf.json tsconfig*.json README.md"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "jsdom": "^27.1.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
